configuration{
    modi: "drun";
    icon-theme: "Papirus-Dark";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: false;
    display-drun: "    Run  ";
    sidebar-mode: false;
}

@theme "~/.config/rofi/themes/catppuccin-mocha2.rasi"